{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agy-phase1-draft/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "prompt_sha256", "rows"],
  "properties": {
    "schema": {"const": "agy-phase1-draft/v2"},
    "batch_id": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handoff_id", "translation_vi", "review_action", "notes"],
        "properties": {
          "handoff_id": {"type": "string", "minLength": 1},
          "translation_vi": {"type": "string", "description": "Nonblank unless the bound prompt row is exact blank keep_identity; host guard enforces this conditional."},
          "review_action": {"enum": ["translated", "provisional_needs_context"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
