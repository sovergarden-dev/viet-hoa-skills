{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viethoa/canonical-editor-handoff/v1",
  "title": "Canonical editor handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "canonical_identity", "files"],
  "properties": {
    "schema": { "const": "viethoa/canonical-editor-handoff/v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "canonical_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_column", "source_column", "target_column", "state_column", "stable_key_scope"],
      "properties": {
        "key_column": { "type": "string", "minLength": 1 },
        "source_column": { "type": "string", "minLength": 1 },
        "target_column": { "type": "string", "minLength": 1 },
        "state_column": { "type": "string", "minLength": 1 },
        "stable_key_scope": { "const": "(domain,key)" },
        "protected_tokens_column": { "type": "string", "minLength": 1 },
        "domain_column": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "domain", "sha256", "row_count", "key_set_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "row_count": { "type": "integer", "minimum": 0 },
          "key_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
