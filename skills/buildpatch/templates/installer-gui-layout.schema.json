{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "buildpatch/installer-gui-layout/v1",
  "title": "Locked native installer GUI layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "client", "protected", "safe", "controls", "locked"],
  "properties": {
    "schema": { "const": "buildpatch/installer-gui-layout/v1" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "const": 1024 },
        "h": { "const": 576 }
      }
    },
    "protected": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rect" }
    },
    "safe": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rect" }
    },
    "controls": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/control" },
      "required": ["install", "uninstall", "signature", "build"]
    },
    "locked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rainbow_phase", "signature_text", "install_label", "uninstall_label"],
      "properties": {
        "rainbow_phase": { "const": 0.045 },
        "signature_text": { "const": "Syrin.online" },
        "install_label": { "type": "string", "minLength": 1 },
        "uninstall_label": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "y", "w", "h"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 },
        "parent": { "type": "string" }
      }
    }
  }
}
