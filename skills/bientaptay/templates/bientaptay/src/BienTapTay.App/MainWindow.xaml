<Window x:Class="BienTapTay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="bientaptay" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource CanvasBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WindowTitleText" Text="bientaptay" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="—" Width="46" Height="36" Padding="0" Click="Minimize_Click" ToolTip="Thu nhỏ" AutomationProperties.Name="Thu nhỏ cửa sổ"/>
                        <Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="□" Width="46" Height="36" Padding="0" Click="Maximize_Click" ToolTip="Phóng to" AutomationProperties.Name="Phóng to hoặc khôi phục cửa sổ"/>
                        <Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="✕" Width="46" Height="36" Padding="0" Click="Close_Click" ToolTip="Đóng" AutomationProperties.Name="Đóng cửa sổ"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="bientaptay" FontSize="21" FontWeight="SemiBold"/>
                        <Border Background="{StaticResource SelectionBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,3">
                            <TextBlock x:Name="ProjectNameText" Foreground="{StaticResource HighlightTextBrush}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="Cỡ chữ" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="FontScaleCombo" Width="78" SelectionChanged="FontScale_Changed" Margin="0,0,8,0" AutomationProperties.Name="Cỡ chữ giao diện">
                            <ComboBoxItem Tag="90">90%</ComboBoxItem>
                            <ComboBoxItem Tag="100">100%</ComboBoxItem>
                            <ComboBoxItem Tag="115">115%</ComboBoxItem>
                            <ComboBoxItem Tag="130">130%</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="ReloadButton" Content="Nạp lại" Click="Reload_Click" ToolTip="Nạp lại canonical từ đĩa (F5)" Margin="0,0,8,0"/>
                        <Button x:Name="SaveButton" Content="Lưu canonical" Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Ghi nguyên tử vào canonical CSV (Ctrl+S)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="2" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="Bản dịch">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10" KeyboardNavigation.TabNavigation="Local">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="2*" MinWidth="260"/>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Phạm vi" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="DatasetFilter" SelectionChanged="DatasetFilter_Changed" DisplayMemberPath="Label" ToolTip="Chọn CSV authoritative cần xem hoặc sửa" TabIndex="0" AutomationProperties.Name="Phạm vi bảng dịch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Tìm kiếm" Style="{StaticResource SectionLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SearchBox" TextChanged="TranslationFilter_Changed" ToolTip="Tìm trong key, người nói, nguồn, tham khảo và bản dịch" TabIndex="1" AutomationProperties.Name="Tìm trong bảng đang mở"/>
                                        <Button x:Name="ProjectSearchButton" Grid.Column="1" Content="Mọi bảng" Click="ProjectSearchButton_Click" Margin="8,0,0,0" Padding="10,6" ToolTip="Tìm trong mọi bảng dịch (Ctrl+Shift+F)" TabIndex="2" AutomationProperties.Name="Tìm trong mọi bảng dịch"/>
                                        <Button x:Name="GoToKeyButton" Grid.Column="2" Content="Tới key" Click="GoToKeyButton_Click" Margin="8,0,0,0" Padding="10,6" ToolTip="Tới đúng full key (Ctrl+G)" TabIndex="3" AutomationProperties.Name="Tới exact key"/>
                                        <Popup x:Name="GoToKeyPopup" PlacementTarget="{Binding ElementName=GoToKeyButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                                <StackPanel Width="430">
                                                    <TextBlock Text="Tới exact key" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Dán nguyên full canonical key Hermes cung cấp." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="GoToKeyInput" PreviewKeyDown="GoToKeyInput_PreviewKeyDown" ToolTip="Exact canonical key"/>
                                                        <Button x:Name="GoToKeyConfirmButton" Grid.Column="1" Content="Đi tới" Click="GoToKeyConfirm_Click" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Trạng thái" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="StatusFilter" SelectionChanged="TranslationFilter_Changed" DisplayMemberPath="Label" TabIndex="4" AutomationProperties.Name="Lọc trạng thái"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Nhóm" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="GroupFilter" SelectionChanged="TranslationFilter_Changed" DisplayMemberPath="Label" IsTextSearchEnabled="True" TabIndex="5" AutomationProperties.Name="Lọc nhóm"/>
                                </StackPanel>
                                <CheckBox x:Name="OnlyIssuesCheck" Grid.Column="4" Content="Chỉ lỗi QA" Foreground="{StaticResource TextBrush}" VerticalAlignment="Bottom" Checked="TranslationFilter_Changed" Unchecked="TranslationFilter_Changed" Margin="4,0,14,8" TabIndex="6" AutomationProperties.Name="Chỉ hiện lỗi QA"/>
                                <Button x:Name="FindReplaceButton" Grid.Column="5" Content="Tìm/thay" Click="FindReplaceButton_Click" VerticalAlignment="Bottom" Margin="0,0,12,0" ToolTip="Tìm/thay trong bản dịch (Ctrl+H)" TabIndex="7" AutomationProperties.Name="Tìm và thay trong bản dịch"/>
                                <TextBlock x:Name="FilteredCountText" Grid.Column="6" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ListPaneColumn" Width="1.1*" MinWidth="500"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition x:Name="EditorPaneColumn" Width="0.9*" MinWidth="420"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <DataGrid x:Name="CanonicalGrid" AutoGenerateColumns="False" IsReadOnly="True" TabIndex="8" AutomationProperties.Name="Danh sách bản dịch canonical"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" Height="648"
                                          VerticalAlignment="Top"
                                          SelectionChanged="CanonicalGrid_SelectionChanged">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Trạng thái" SortMemberPath="status" Binding="{Binding StatusLabel}" Width="120"/>
                                        <DataGridTextColumn Header="Người nói" SortMemberPath="speaker" Binding="{Binding Speaker}" Width="100"/>
                                        <DataGridTextColumn Header="Key" SortMemberPath="key" Binding="{Binding Key}" Width="250"/>
                                        <DataGridTextColumn Header="Bản dịch" SortMemberPath="target" Binding="{Binding TargetPreview}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="NoRowsText" Text="Không có dòng phù hợp bộ lọc." Foreground="{StaticResource MutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>

                            <GridSplitter x:Name="EditorGridSplitter" Grid.Column="1" Width="6" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Thay đổi độ rộng danh sách và vùng biên tập"/>

                            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                                    <StackPanel DataContext="{Binding SelectedItem, ElementName=CanonicalGrid}">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                            <TextBlock Text="{Binding Speaker, StringFormat=Người nói: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Group, StringFormat=Nhóm: {0}}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BookmarksCountText" Grid.ColumnSpan="2" Text="Dấu trang (0)" Style="{StaticResource SectionLabel}"/>
                                            <ComboBox x:Name="BookmarkPicker" Grid.Row="1" DisplayMemberPath="Display" SelectionChanged="BookmarkPicker_Changed" IsEnabled="False" ToolTip="Chọn để tới exact key đã đánh dấu" TabIndex="9" AutomationProperties.Name="Chọn dấu trang"/>
                                            <Button x:Name="BookmarkToggleButton" Grid.Row="1" Grid.Column="1" Content="☆ Đánh dấu" Click="BookmarkToggle_Click" Margin="8,0,0,0" IsEnabled="False" ToolTip="Thêm hoặc bỏ exact key hiện tại khỏi dấu trang" TabIndex="10" AutomationProperties.Name="Thêm hoặc bỏ dấu exact key hiện tại"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Sources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,13">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}"/>
                                                        <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Bản dịch final" Style="{StaticResource SectionLabel}"/>
                                        <TextBox x:Name="TargetEditor" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="260" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" TabIndex="11" AutomationProperties.Name="Bản dịch final"/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Trạng thái" Style="{StaticResource SectionLabel}"/>
                                                <ComboBox x:Name="EditorStatusCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}" TabIndex="12" AutomationProperties.Name="Trạng thái dòng đang sửa"/>
                                                <Button x:Name="RevertRowButton" Content="Hoàn tác dòng" Click="RevertRow_Click" Margin="0,8,0,0" IsEnabled="False" ToolTip="Trả target, trạng thái và ghi chú về bản vừa lưu; không nạp lại file" TabIndex="13"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Protected tokens từ nguồn Nhật" Style="{StaticResource SectionLabel}"/>
                                                <ItemsControl ItemsSource="{Binding SourceTokens}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource SelectionBrush}" CornerRadius="3" Padding="8,3" Margin="0,0,6,6">
                                                                <TextBlock Text="{Binding}" Foreground="{StaticResource HighlightTextBrush}" FontFamily="Consolas"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Không có token." Foreground="{StaticResource MutedBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceTokens.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Ghi chú biên tập" Style="{StaticResource SectionLabel}" Margin="0,13,0,6"/>
                                        <TextBox x:Name="ReviewNotesEditor" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" TabIndex="14" AutomationProperties.Name="Ghi chú biên tập"/>

                                        <Border x:Name="ValidationBorder" Background="{StaticResource DangerSurfaceBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                                        </Border>

                                        <TextBlock Text="Thuật ngữ liên quan" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                                        <TextBlock Text="{Binding MatchingGlossary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

                                        <TextBlock Text="Xưng hô" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                                        <TextBlock Text="{Binding PronounGuidance}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

                                        <TextBlock Text="Hội thoại trong scene" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                                        <ItemsControl x:Name="DialogueContextItems" ItemsSource="{Binding DialogueTurns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="DialogueTurn_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ToolTip="Tới exact key đầu tiên của lượt hội thoại" TabIndex="15" AutomationProperties.Name="{Binding PrimaryKey, StringFormat=Tới lượt hội thoại {0}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                                                        </Button.Template>
                                                        <Border BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,0,7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Keys}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                            <TextBlock Text="{Binding Target}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                            </Border>
                                                            </Button>
                                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PrevPageButton" Content="◀ Trang trước" Click="PrevPage_Click" ToolTip="Trang trước (mũi tên trái)"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="PageJumpButton" Click="PageJumpButton_Click" ToolTip="Bấm để nhập số trang cần tới" Padding="10,6" MinHeight="32">
                                        <TextBlock x:Name="PageText"/>
                                    </Button>
                                    <ComboBox x:Name="RowsPerPageCombo" SelectedIndex="1" SelectionChanged="RowsPerPage_Changed" Width="92" Margin="8,0,0,0" ToolTip="Chọn số hàng cố định trên mỗi trang">
                                        <ComboBoxItem Tag="10">10 hàng</ComboBoxItem>
                                        <ComboBoxItem Tag="17">17 hàng</ComboBoxItem>
                                        <ComboBoxItem Tag="25">25 hàng</ComboBoxItem>
                                        <ComboBoxItem Tag="50">50 hàng</ComboBoxItem>
                                        <ComboBoxItem Tag="100">100 hàng</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock x:Name="PageRangeText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="NextPageButton" Grid.Column="2" Content="Trang sau ▶" Click="NextPage_Click" ToolTip="Trang sau (mũi tên phải)"/>
                                <Popup x:Name="PageJumpPopup" PlacementTarget="{Binding ElementName=PageJumpButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                        <StackPanel Width="220">
                                            <TextBlock Text="Đi tới trang" FontWeight="SemiBold"/>
                                            <TextBlock Text="Nhập số trang rồi bấm Enter." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="PageJumpInput" PreviewKeyDown="PageJumpInput_PreviewKeyDown" ToolTip="Số trang cần tới"/>
                                                <Button x:Name="PageJumpConfirmButton" Grid.Column="1" Content="Đi tới" Click="PageJumpConfirm_Click" Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Thuật ngữ">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Thêm" Click="GlossaryAdd_Click" Margin="8,0,0,0"/>
                                    <Button Content="Xóa" Click="GlossaryDelete_Click" Margin="8,0,0,0"/>
                                    <Button Content="Nạp lại" Click="GlossaryReload_Click" Margin="8,0,0,0"/>
                                    <Button Content="Lưu" Style="{StaticResource PrimaryButton}" Click="GlossarySave_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="GlossarySearchBox" TextChanged="GlossarySearch_Changed" ToolTip="Tìm trong toàn bộ glossary"/>
                            </DockPanel>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="GlossaryGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Xưng hô">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Thêm" Click="PronounAdd_Click" Margin="8,0,0,0"/>
                                    <Button Content="Xóa" Click="PronounDelete_Click" Margin="8,0,0,0"/>
                                    <Button Content="Nạp lại" Click="PronounReload_Click" Margin="8,0,0,0"/>
                                    <Button Content="Lưu" Style="{StaticResource PrimaryButton}" Click="PronounSave_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="PronounSearchBox" TextChanged="PronounSearch_Changed" ToolTip="Tìm theo nhân vật, quan hệ hoặc cách xưng hô"/>
                            </DockPanel>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="PronounsGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Dự án">
                    <Grid Margin="18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Thông tin đồng bộ" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBox Grid.Row="1" x:Name="ProjectInfoText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ExternalDiffTab" Header="Thay đổi ngoài">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="190"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ExternalDiffSummaryText" Text="Chưa ghi nhận thay đổi ngoài trong phiên này." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Tới dòng" Click="ExternalDiffGoTo_Click" Margin="8,0,0,0"/>
                                    <Button Content="Nạp file ngoài" Click="ExternalDiffReload_Click" Margin="8,0,0,0"/>
                                    <Button x:Name="ExternalDiffClearButton" Content="Xóa lịch sử" Click="ExternalDiffClear_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="ExternalDiffGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConflict}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FileLabel}" Width="150"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="70"/>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="260"/>
                                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="150"/>
                                <DataGridTextColumn Header="Bản đã nạp" Binding="{Binding LoadedPreview}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="Đang sửa" Binding="{Binding LocalPreview}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="File ngoài" Binding="{Binding ExternalPreview}" Width="*" MinWidth="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0"
                                DataContext="{Binding SelectedItem, ElementName=ExternalDiffGrid}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Bản đã nạp" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding LoadedValue, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="Đang sửa trong app" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding LocalValue, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="File ngoài" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding ExternalValue, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ConsistencyQaTab" Header="QA nhất quán">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="250"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="QA nhất quán" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ConsistencyQaSummaryText" Text="Chưa quét bảng hiện tại." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="ConsistencyQaSidecarErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                               AutomationProperties.Name="Cảnh báo sidecar quyết định QA"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="ConsistencyQaGoToButton" Content="Tới dòng" Click="ConsistencyQaGoTo_Click" Margin="8,0,0,0"/>
                                    <Button x:Name="ConsistencyQaScanButton" Content="Quét lại" Click="ConsistencyQaScan_Click" Margin="8,0,0,0" ToolTip="Quét cảnh báo, không tự sửa dữ liệu"/>
                                    <Button x:Name="ConsistencyQaExportReportButton" Content="Xuất báo cáo" Click="ConsistencyQaExportReport_Click" Margin="8,0,0,0" ToolTip="Xuất báo cáo QA chỉ đọc, không đổi canonical"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Loại cảnh báo" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="ConsistencyQaKindFilter" SelectedIndex="0" SelectionChanged="ConsistencyQaFilter_Changed" AutomationProperties.Name="Lọc loại cảnh báo QA">
                                        <ComboBoxItem Content="Mọi loại" Tag=""/>
                                        <ComboBoxItem Content="Trùng source" Tag="DuplicateSource"/>
                                        <ComboBoxItem Content="Glossary" Tag="GlossaryDrift"/>
                                        <ComboBoxItem Content="Xưng hô" Tag="PronounDeviation"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="Speaker" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="ConsistencyQaSpeakerFilter" SelectionChanged="ConsistencyQaFilter_Changed" AutomationProperties.Name="Lọc speaker QA"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Quyết định" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="ConsistencyQaDecisionFilter" SelectedIndex="1" SelectionChanged="ConsistencyQaFilter_Changed" AutomationProperties.Name="Lọc quyết định QA">
                                        <ComboBoxItem Content="Mọi quyết định" Tag=""/>
                                        <ComboBoxItem Content="Chưa phân loại" Tag="Unreviewed"/>
                                        <ComboBoxItem Content="Cần sửa" Tag="NeedsFix"/>
                                        <ComboBoxItem Content="Chấp nhận khác biệt" Tag="AcceptedDifference"/>
                                        <ComboBoxItem Content="Đã xử lý" Tag="Resolved"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="2" x:Name="ConsistencyQaGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ConsistencyQaGrid_SelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Review"><Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Cảnh báo"><Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="115"/>
                                <DataGridTextColumn Header="Quyết định" Binding="{Binding TriageLabel}" Width="145"/>
                                <DataGridTextColumn Header="Mức" Binding="{Binding Severity}" Width="80"/>
                                <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="115"/>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="270"/>
                                <DataGridTextColumn Header="Cảnh báo" Binding="{Binding Message}" Width="*" MinWidth="360"/>
                                <DataGridTextColumn Header="Key liên quan" Binding="{Binding RelatedKeys}" Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0"
                                DataContext="{Binding SelectedItem, ElementName=ConsistencyQaGrid}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Nguồn canonical" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding Source, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="Bản dịch hiện tại" Style="{StaticResource SectionLabel}" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding Target, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="Chi tiết cảnh báo" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding Message, Mode=OneWay}" Height="52" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="So sánh target theo full key" Style="{StaticResource SectionLabel}" Margin="0,7,0,0"/>
                                    <DataGrid x:Name="ConsistencyQaRelatedGrid" Height="108" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ConsistencyQaRelatedGrid_SelectionChanged" AutomationProperties.Name="So sánh các key liên quan">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="" Binding="{Binding Marker}" Width="24"/>
                                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="150"/>
                                            <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="70"/>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" MinWidth="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                        <Button x:Name="ConsistencyQaRelatedPreviousButton" Content="← Trước" Click="ConsistencyQaRelatedPrevious_Click" IsEnabled="False" Padding="8,3" AutomationProperties.Name="Key liên quan trước"/>
                                        <Button x:Name="ConsistencyQaRelatedNextButton" Content="Sau →" Click="ConsistencyQaRelatedNext_Click" IsEnabled="False" Padding="8,3" Margin="5,0,0,0" AutomationProperties.Name="Key liên quan sau"/>
                                        <Button x:Name="ConsistencyQaRelatedGoToButton" Content="Tới key" Click="ConsistencyQaRelatedGoTo_Click" IsEnabled="False" Padding="8,3" Margin="5,0,0,0" AutomationProperties.Name="Tới exact key liên quan"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="Quyết định review" Style="{StaticResource SectionLabel}"/>
                                    <ComboBox x:Name="ConsistencyQaTriageCombo" SelectedIndex="0" AutomationProperties.Name="Quyết định cho cảnh báo QA">
                                        <ComboBoxItem Content="Chưa phân loại" Tag="Unreviewed"/>
                                        <ComboBoxItem Content="Cần sửa" Tag="NeedsFix"/>
                                        <ComboBoxItem Content="Chấp nhận khác biệt" Tag="AcceptedDifference"/>
                                        <ComboBoxItem Content="Đã xử lý" Tag="Resolved"/>
                                    </ComboBox>
                                    <TextBlock Text="Ghi chú" Style="{StaticResource SectionLabel}" Margin="0,8,0,0"/>
                                    <TextBox x:Name="ConsistencyQaDecisionNoteBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Ghi chú quyết định QA"/>
                                    <TextBlock x:Name="ConsistencyQaStaleText" Text="Nội dung đã đổi; quyết định cũ không còn áp dụng." Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button x:Name="ConsistencyQaCopyContextButton" Content="Sao chép context" Click="ConsistencyQaCopyContext_Click" Padding="9,4" AutomationProperties.Name="Sao chép context packet QA"/>
                                        <Button x:Name="ConsistencyQaSaveDecisionButton" Content="Lưu quyết định" Style="{StaticResource PrimaryButton}" Click="ConsistencyQaSaveDecision_Click" IsEnabled="False" Margin="6,0,0,0" AutomationProperties.Name="Lưu quyết định QA"/>
                                        <Button x:Name="ConsistencyQaSaveNextButton" Content="Lưu &amp; kế tiếp" Click="ConsistencyQaSaveNext_Click" IsEnabled="False" Margin="6,0,0,0" AutomationProperties.Name="Lưu quyết định QA và tới cảnh báo kế tiếp"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusMessageText" Foreground="{StaticResource MutedBrush}" AutomationProperties.Name="Trạng thái ứng dụng" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Grid.Column="1" Text="Ctrl+F bảng này  •  Ctrl+Shift+F mọi bảng  •  Ctrl+H tìm/thay  •  Ctrl+G key  •  Ctrl+S lưu  •  F5 nạp  •  ← → trang  •  F3 dòng cần sửa" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Grid x:Name="ProjectSearchOverlay" Grid.RowSpan="4" Panel.ZIndex="21" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
                <Border Width="1060" Height="670" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="165"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tìm trong mọi bảng dịch" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Chỉ đọc; kết quả giữ file, exact key và trường khớp. Ctrl+F vẫn lọc bảng đang mở." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Click="ProjectSearchClose_Click" Width="38" Height="32" Padding="0" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng tìm kiếm mọi bảng"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ProjectSearchInput" PreviewKeyDown="ProjectSearchInput_PreviewKeyDown" ToolTip="Tìm trong key, speaker, nhóm, mọi nguồn, target và ghi chú"/>
                            <Button x:Name="ProjectSearchRunButton" Grid.Column="1" Content="Tìm" Style="{StaticResource PrimaryButton}" Click="ProjectSearchRun_Click" Margin="8,0,0,0"/>
                        </Grid>

                        <DataGrid Grid.Row="2" x:Name="ProjectSearchGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="ProjectSearchGrid_SelectionChanged" MouseDoubleClick="ProjectSearchGrid_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bảng" Binding="{Binding FileLabel}" Width="135"/>
                                <DataGridTextColumn Header="Khớp ở" Binding="{Binding MatchField}" Width="95"/>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="245"/>
                                <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="100"/>
                                <DataGridTextColumn Header="Nội dung khớp" Binding="{Binding MatchedPreview}" Width="*" MinWidth="220"/>
                                <DataGridTextColumn Header="Bản dịch" Binding="{Binding TargetPreview}" Width="*" MinWidth="220"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0"
                                DataContext="{Binding SelectedItem, ElementName=ProjectSearchGrid}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Nguồn chuẩn" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding Source, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Bản dịch" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding Target, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProjectSearchSummaryText" Text="Nhập từ khóa cần tìm trong mọi bảng dịch." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="ProjectSearchGoToButton" Grid.Column="1" Content="Tới exact key" Style="{StaticResource PrimaryButton}" Click="ProjectSearchGoTo_Click" IsEnabled="False" Margin="8,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="FindReplaceOverlay" Grid.RowSpan="4" Panel.ZIndex="20" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
                <Border Width="980" Height="610" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tìm/thay trong bản dịch" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Tìm chuỗi nguyên văn; mọi thay đổi được xem trước và kiểm token trước khi áp dụng vào RAM." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Click="FindReplaceClose_Click" Width="38" Height="32" Padding="0" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng tìm và thay"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Tìm" Style="{StaticResource SectionLabel}"/>
                                <TextBox x:Name="FindReplaceFindTextBox" TextChanged="FindReplaceInput_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Thay bằng" Style="{StaticResource SectionLabel}"/>
                                <TextBox x:Name="FindReplaceReplacementTextBox" TextChanged="FindReplaceInput_Changed"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="FindReplaceMatchCaseCheck" Content="Phân biệt hoa/thường" Click="FindReplaceOption_Changed" Margin="0,0,18,0"/>
                                <CheckBox x:Name="FindReplaceFilteredOnlyCheck" Content="Chỉ kết quả đang lọc" IsChecked="True" Click="FindReplaceOption_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Tìm tiếp" Click="FindReplaceNext_Click"/>
                                <Button Content="Xem trước" Click="FindReplacePreview_Click" Margin="8,0,0,0"/>
                                <Button x:Name="ReplaceApplyButton" Content="Thay tất cả" Style="{StaticResource PrimaryButton}" Click="FindReplaceApply_Click" IsEnabled="False" Margin="8,0,0,0"/>
                                <Button x:Name="ReplaceUndoButton" Content="Hoàn tác batch" Click="ReplaceUndo_Click" IsEnabled="False" Margin="8,0,0,0" ToolTip="Hoàn tác toàn bộ batch gần nhất trước khi lưu"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="3" x:Name="ReplacePreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="240"/>
                                <DataGridTextColumn Header="Lần" Binding="{Binding Occurrences}" Width="55"/>
                                <DataGridTextColumn Header="Trước" Binding="{Binding Before}" Width="*" MinWidth="240"/>
                                <DataGridTextColumn Header="Sau" Binding="{Binding After}" Width="*" MinWidth="240"/>
                                <DataGridTextColumn Header="QA" Binding="{Binding ValidationMessage}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="4" x:Name="ReplacePreviewSummaryText" Text="Bấm Xem trước để kiểm số dòng và lỗi QA trước khi thay."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
